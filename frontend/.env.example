# 服务端转发配置。INTERNAL_API_TOKEN 属于密钥，禁止使用 NEXT_PUBLIC_ 前缀。
INTERNAL_API_BASE_URL=http://localhost:8010
INTERNAL_API_TOKEN=replace-with-a-random-secret
INVITE_CODES=GROK-EXAMPLE1,GROK-EXAMPLE2
AUTH_SECRET=replace-with-a-random-signing-secret
# 邀请体验会话时长，默认 3600 秒；允许范围 300~86400 秒。
INVITE_SESSION_TTL_SECONDS=3600
